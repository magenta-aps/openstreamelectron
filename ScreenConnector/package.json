{
  "name": "screenconnector",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": {
    "name": "Magenta Open Source IT",
    "email": "ln@magenta-aps.dk"
  },
  "homepage": "https://openstream.dk",
  "description": "OpenStream Electron App Screen Connector",
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "build": {
    "appId": "dk.openstream.screenconnector",
    "productName": "Openstream",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "ln@magenta-aps.dk",
      "artifactName": "ScreenConnector-${version}-${arch}.${ext}"
    }
  }
}
